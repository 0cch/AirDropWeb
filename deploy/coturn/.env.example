# Public DNS name for the TURN server, e.g. turn.example.com
TURN_REALM=turn.example.com

# Generate with: openssl rand -hex 32
TURN_SECRET=replace-with-a-long-random-secret

# Per-allocation bandwidth limit in bytes/second
TURN_MAX_BPS=5000000

# Concurrent allocation quotas
TURN_TOTAL_QUOTA=100
TURN_USER_QUOTA=4