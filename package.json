{
  "name": "p2p-file-transfer",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace p2p-signaling-server",
    "dev:client": "npm run dev --workspace p2p-file-transfer-client",
    "dev": "concurrently -k -n server,client \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build --workspace p2p-file-transfer-client",
    "typecheck": "npm run typecheck --workspace p2p-file-transfer-client",
    "test": "npm run test --workspace p2p-file-transfer-client && npm run test --workspace p2p-signaling-server",
    "start": "npm run start --workspace p2p-signaling-server",
    "audit:prod": "npm audit --omit=dev"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
